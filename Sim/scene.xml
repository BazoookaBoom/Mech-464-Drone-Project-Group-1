<mujoco model="CF2 scene">
  <include file="cf2.xml"/>

  <statistic center="0 0 0.1" extent="0.2" meansize=".05"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0 0 0 0"/>
    <global azimuth="-20" elevation="-20" ellipsoidinertia="true"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    <material name="wall" rgba="0.6 0.6 0.6 1"/>
  </asset>

  <worldbody>
    <light pos="0 0 3" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>

    <!-- Walls at ±3 m — gives rangefinders clear targets -->
    <geom name="wall_north" type="box" size="3.05 0.05 1.5" pos=" 0  3 1.5" material="wall"/>
    <geom name="wall_south" type="box" size="3.05 0.05 1.5" pos=" 0 -3 1.5" material="wall"/>
    <geom name="wall_east"  type="box" size="0.05 3.05 1.5" pos=" 3  0 1.5" material="wall"/>
    <geom name="wall_west"  type="box" size="0.05 3.05 1.5" pos="-3  0 1.5" material="wall"/>

  <!-- Obstacles -->
    <body pos="1 0 0.2">
        <geom type="box" size="0.2 0.2 0.5" rgba="1 0 0 1"/>
    </body>

    <!-- <body pos="2 2 0.2">
        <geom type="box" size="0.2 0.2 2.5" rgba="1 0 0 1"/>
    </body> -->

    <body pos="2 -2 0.2">
        <geom type="box" size="0.2 0.2 0.25" rgba="1 0 0 1"/>
    </body>

    <!-- <body pos="2.5 0 0.2">
        <geom type="box" size="0.1 0.1 1" rgba="1 0 0 1"/>
    </body> -->

    <body pos="-2 2 0.3">
        <geom type="cylinder" size="0.1 0.25" rgba="0 0 1 1"/>
    </body>

    <body pos="0.5 2 0.3">
        <geom type="cylinder" size="0.2 0.75" rgba="0 0 1 1"/>
    </body>

    <body pos="0 -2 0.3">
        <geom type="cylinder" size="0.5 0.5" rgba="0 0 1 1"/>
    </body>

    <body pos="-2 -2 0.3">
        <geom type="cylinder" size="1 0.125" rgba="0 0 1 1"/>
    </body>

    <body pos="0 1 0">
        <geom type="box" size="0.125 0.125 0.75" rgba="0 1 0 1"/>
    </body>
    <body pos="0 -1 0">
        <geom type="box" size="0.125 0.125 0.75" rgba="0 1 0 1"/>
    </body>
    <body pos="-1 1 0">
        <geom type="box" size="0.125 0.125 0.75" rgba="0 1 0 1"/>
    </body>
     <body pos="-1 -1 0"> 
        <geom type="box" size="0.125 0.125 0.75" rgba="0 1 0 1"/>
    </body>
    <body pos="-0.5 0 0.75"> 
        <geom type="box" size="0.75 1.25 0.05" rgba="0 1 0 1"/>
    </body>

  </worldbody>
</mujoco>
